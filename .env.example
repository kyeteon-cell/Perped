# ---- Privy (https://dashboard.privy.io) ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Hyperliquid ----
# Where orders are signed and balances read: testnet | mainnet
NEXT_PUBLIC_HL_NETWORK=testnet
# Where prices, candles, volume and funding come from. Default mainnet so the feed shows real prices
# even while trading on testnet. (Testnet fills land at testnet prices, so go mainnet for the real thing.)
NEXT_PUBLIC_HL_DATA_NETWORK=mainnet
# Your builder wallet address (the one that earns builder fees). Needs >= 100 USDC
# in its perps account on the chosen network before fees can be attached.
NEXT_PUBLIC_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# Builder fee tiers, in tenths of a basis point (10 = 1 bp = 0.01%). Perps cap is 100 (0.1%).
# Users approve the MAX once; each order is charged at their tier rate (never above the max).
NEXT_PUBLIC_BUILDER_MAX_FEE_TENTHS_BPS=70
NEXT_PUBLIC_BUILDER_FEE_TENTHS_BPS=50            # standard 0.05%
NEXT_PUBLIC_BUILDER_FEE_REFERRED_TENTHS_BPS=35   # joined with a referral code 0.035%
NEXT_PUBLIC_BUILDER_FEE_TOP_TENTHS_BPS=25        # top of the 30-day board 0.025%
NEXT_PUBLIC_TOP_TIER_RANK=100

# ---- Referral programme ----
# Referrer's cut of the builder fee their referees pay. Rises to the top share once they have
# NEXT_PUBLIC_REFERRAL_TOP_THRESHOLD referees who traded in the last 30 days.
NEXT_PUBLIC_REFERRAL_SHARE_PCT=25
NEXT_PUBLIC_REFERRAL_TOP_SHARE_PCT=40
NEXT_PUBLIC_REFERRAL_TOP_THRESHOLD=10

# ---- Database (Postgres: Neon / Supabase / Railway free tier) ----
DATABASE_URL=postgres://user:pass@host:5432/perped

# ---- App ----
NEXT_PUBLIC_APP_NAME=Perped
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Guardrails (new-user defaults)
# Fallback only: the live cap follows Hyperliquid's max leverage on the HYPE pair.
NEXT_PUBLIC_MAX_LEVERAGE=10
NEXT_PUBLIC_MAX_POSITION_USD=500

# Set to 0 to stop the app running its idempotent schema migration on startup (then use /api/setup).
AUTO_MIGRATE=1

# ---- Cron protection (Vercel sends Authorization: Bearer <CRON_SECRET>) ----
CRON_SECRET=

# ---- On-ramp (optional): hosted widget URL from MoonPay / Transak. Wallet + amount are appended. ----
NEXT_PUBLIC_ONRAMP_URL=

# ---- Demo traders ----
# Set to 1 to pause the bot cron without removing the demo accounts.
BOTS_PAUSED=
# 1 = anyone can use demo mode (default). 0 = demo removed: hidden from onboarding/settings, paper trades refused.
NEXT_PUBLIC_DEMO_ENABLED=1
